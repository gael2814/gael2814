# ---- Database (PostgreSQL) ----
# Use the pooled URL for DATABASE_URL and the direct (non-pooled) URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aytacos"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aytacos"

# ---- App ----
# Public URL of the website (used in emails and payment redirects), no trailing slash
APP_URL="https://www.your-domain.com"
# Random secret for staff sign-in sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# ---- First owner account (used once by `npm run db:seed`) ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Owner"

# ---- Payments ----
# "stripe" for real payments. "mock" = built-in test page (never allowed in production).
PAYMENTS_PROVIDER="stripe"
# Start with test keys (sk_test_...). Switch to live keys (sk_live_...) when ready.
STRIPE_SECRET_KEY=""
# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=""

# ---- Email (Resend) ----
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend
EMAIL_FROM="Ay Ay Tacos <orders@your-domain.com>"
EMAIL_REPLY_TO=""

# ---- Scheduled job protection (Vercel sends this automatically to cron routes) ----
CRON_SECRET=""

# ---- Local preview only (ignored in production) ----
# Pretend it's a specific time so you can test the 9:00–10:30 ordering window.
# DEV_NOW_OVERRIDE="2026-10-12T09:30:00"
